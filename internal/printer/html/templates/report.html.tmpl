<!DOCTYPE html>
<html lang="en"{{if .InitialTheme}} data-theme="{{.InitialTheme}}"{{end}}>
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Coverage Report — covlens</title>
<script>
// Apply saved theme before first paint to avoid flash.
(function(){var t=localStorage.getItem('covlens-theme');if(t)document.documentElement.setAttribute('data-theme',t);})();
</script>
<style>{{.CSS}}</style>
</head>
<body>

<!-- Sidebar / file nav -->
<nav class="sidebar">
  <h2>Files</h2>
  <ul>
  {{range .Files}}{{if or (not .Excluded) $.ShowExcluded}}
    <li>
      <a href="#file-{{.Path}}" title="{{.Path}}">
        <span class="status-dot {{.Status}}"></span>{{.Path}}
      </a>
    </li>
  {{end}}{{end}}
  </ul>
</nav>

<div class="main-content">
  <h1>Coverage Report</h1>
  <p class="meta">
    Base branch: <strong>{{.BaseBranch}}</strong> &middot;
    Generated: <strong>{{.GeneratedAt}}</strong> &middot;
    Files: <strong>{{.FileCount}}</strong>
  </p>

  {{if eq (len .Files) 0}}
  <div class="status-bar status-pass">
    &#10004; {{if eq .DiffStatus "only-deletions"}}All changed Go files were deleted; nothing to measure.{{else}}No Go files changed relative to <code>{{.BaseBranch}}</code>; nothing to measure.{{end}}
  </div>
  {{else}}
  <!-- Status bar -->
  {{if and .DiffPassed .TotalPassed}}
  <div class="status-bar status-pass">&#10004; All coverage thresholds passed</div>
  {{else}}
  <div class="status-bar status-fail">&#10008; One or more coverage thresholds not met</div>
  {{end}}

  <!-- Badges -->
  <div class="badges">
    {{if not .FullMode}}
    {{if eq .DiffStatus "all-excluded"}}
    <div class="badge badge-neutral">
      <h2>&ndash;</h2>
      <p>Diff coverage (changed lines)</p>
      <div class="threshold">All changed Go files excluded by <code>exclude_files</code></div>
    </div>
    {{else}}
    <div class="badge {{if .DiffPassed}}badge-ok{{else}}badge-fail{{end}}">
      <h2>{{printf "%.1f" .DiffCoverage}}%</h2>
      <p>Diff coverage (changed lines)</p>
      <div class="threshold">
        Threshold: {{printf "%.0f" .DiffThreshold}}%
        {{if .DiffPassed}}&#10004;{{else}}&#10008;{{end}}
      </div>
    </div>
    {{end}}
    {{if .HasDelta}}
    <div class="badge badge-delta-{{.DeltaClass}}">
      <h2>{{if gt .CoverageDelta 0.0}}+{{end}}{{printf "%.2f" .CoverageDelta}}pp</h2>
      <p>Total coverage change</p>
      <div class="threshold">vs {{printf "%.1f" .BaselineTotalCoverage}}% at merge-base</div>
    </div>
    {{end}}
    {{end}}
    {{if .TotalMeasured}}
    <div class="badge {{if .TotalAboveThreshold}}badge-ok{{else}}badge-fail{{end}}">
      <h2>{{printf "%.1f" .TotalCoverage}}%</h2>
      <p>Total project coverage</p>
      <div class="threshold">
        Threshold: {{printf "%.0f" .TotalThreshold}}%
        {{if .TotalAboveThreshold}}&#10004;{{else}}&#10008;{{end}}
      </div>
    </div>
    {{end}}
  </div>
  {{end}}

  <!-- File table -->
  <section>
    <h3>Changed files</h3>
    <table>
      <thead>
        <tr><th>File</th><th>Coverage</th><th>Status</th></tr>
      </thead>
      <tbody>
      {{range .Files}}{{if or (not .Excluded) $.ShowExcluded}}
        <tr>
          <td class="file"><a href="#file-{{.Path}}">{{.Path}}</a></td>
          {{if .Excluded}}
          <td>&mdash;</td>
          <td><span class="excluded-badge">excluded</span></td>
          {{else if lt .Coverage 0.0}}
          <td class="cov warn">n/a</td>
          <td class="warn">&#9888;</td>
          {{else}}
          <td class="cov {{.Status}}">
            {{printf "%.1f" .Coverage}}%
            {{if gt .Statements 0}}<span class="stmt-count">{{.Covered}}/{{.Statements}} stmts</span>{{end}}
          </td>
          <td class="{{.Status}}">
            {{if eq .Status "ok"}}&#10004;{{else if eq .Status "fail"}}&#10008;{{else}}&#9888;{{end}}
          </td>
          {{end}}
        </tr>
      {{end}}{{end}}
      </tbody>
    </table>
  </section>

  <!-- Source viewer sections -->
  {{range .SourceFiles}}
  <section class="source-section" id="file-{{.Path}}">
    <div class="source-header">
      <div>
        <h4>{{.Path}}</h4>
        <span class="source-meta">{{.Package}} &middot; {{if lt .Coverage 0.0}}n/a{{else}}{{printf "%.1f" .Coverage}}%{{end}}</span>
      </div>
      <button class="jump-uncovered" onclick="jumpToUncovered('file-{{.Path}}')">Jump to uncovered</button>
    </div>
    <div class="source-code">
      {{.SourceHTML}}
    </div>
  </section>
  {{end}}

  <p class="note">
    Green = covered &middot; Red = uncovered &middot;
    Generated by <strong>covlens</strong>
  </p>
</div>

<div class="theme-switch" onclick="toggleTheme()" title="Toggle light/dark mode">
  <span class="switch-icon">☀</span>
  <span class="switch-track" id="switch-track"><span class="switch-thumb"></span></span>
  <span class="switch-icon">🌙</span>
</div>

<a href="#" class="back-to-top" title="Back to top">↑ Top</a>

<script>
function jumpToUncovered(sectionId) {
  var section = document.getElementById(sectionId);
  if (!section) return;
  var uncovered = section.querySelector('.uncovered');
  if (uncovered) {
    uncovered.scrollIntoView({behavior: 'smooth', block: 'center'});
  }
}

function effectiveTheme() {
  var t = document.documentElement.getAttribute('data-theme');
  if (t === 'light' || t === 'dark') return t;
  return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
}

function syncSwitch(isDark) {
  var track = document.getElementById('switch-track');
  if (track) track.classList.toggle('is-dark', isDark);
}

function toggleTheme() {
  var next = effectiveTheme() === 'dark' ? 'light' : 'dark';
  document.documentElement.setAttribute('data-theme', next);
  localStorage.setItem('covlens-theme', next);
  syncSwitch(next === 'dark');
}

syncSwitch(effectiveTheme() === 'dark');
</script>
</body>
</html>
